# this is a template for the .env file, it shows which settings the project needs
# copy it to .env and put your own password in it
# .env stays only on your computer, .gitignore keeps it off github, and this example file is the one that goes to github

# database settings
# postgres uses these to create the database and the user the very first time it starts,
# and the api and the fetcher use the same ones to log in (docker-compose.yml passes them on)
DB_NAME=tennis
DB_USER=postgres
DB_PASSWORD=change_me

# the port on your computer where the api shows up, so http://localhost:8000/docs
# change it if 8000 is already taken (windows sometimes reserves ports around 8000)
API_PORT=8000
