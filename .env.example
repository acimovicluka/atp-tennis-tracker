# copy this file to .env and put your own password in it
# .env stays on your computer only, it's in .gitignore so it never goes to github

# database settings
# postgres uses these to create the database the first time it starts,
# and the api and the fetcher use the same ones to log in
DB_NAME=tennis
DB_USER=postgres
DB_PASSWORD=change_me

# port on your computer where the api shows up
# change it if 8000 is already taken
API_PORT=8000
