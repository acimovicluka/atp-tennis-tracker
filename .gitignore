# python bytecode cache, gets created automatically when the script runs
__pycache__/
*.pyc

# passwords and local settings - this one must never end up on github
.env

# virtual environments, in case I make one
venv/
.venv/

# vs code settings, nobody else needs them
.vscode/

# terraform downloads its plugins here, it's huge and gets downloaded again with terraform init
.terraform/

# terraform state, the list of everything terraform created on aws
# it can hold secrets and ip addresses, so it stays on my computer only
*.tfstate
*.tfstate.*

# files with my own values for the variables
*.tfvars

# made by terraform with the ip of the current server, it changes every time
ansible/inventory.ini
