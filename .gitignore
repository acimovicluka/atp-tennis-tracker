# .gitignore tells git which files to never track, so they never end up on github
# mostly that's passwords, files that are made by tools, and things that only make sense on my computer

# python's bytecode cache, python makes it by itself when a script runs
__pycache__/
*.pyc

# my passwords and local settings, this one must never end up on github
.env

# virtual environments, in case I make one
venv/
.venv/

# vs code settings, nobody else needs them
.vscode/

# terraform downloads its plugins (providers) here, it's huge and terraform init downloads it again anyway
.terraform/

# the terraform state, terraform's list of everything it created on aws
# it can hold secrets and ip addresses, so it stays only on my computer
*.tfstate
*.tfstate.*

# files with my own values for the terraform variables
*.tfvars

# terraform writes this file with the ip of the current server, and the ip changes with every new server
ansible/inventory.ini

# the kubernetes secret with the real password, same idea as .env
k8s/secret.yaml

# my notes for claude code, they stay only on my computer
CLAUDE.md

# pytest makes this folder when the tests run
.pytest_cache/
