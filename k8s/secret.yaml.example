# template for k8s/secret.yaml, the kubernetes version of .env.example
# copy it to secret.yaml and put your own password in it
# secret.yaml is in .gitignore, so the real password never goes to github
# the name ends in .example on purpose, so kubectl apply -f k8s/ skips it and never overwrites the real secret

apiVersion: v1
kind: Secret
metadata:
  name: atp-db          # the api, the fetcher and the database find it by this name
type: Opaque            # a plain secret with my own keys, nothing special
stringData:             # plain text here, kubernetes stores it encoded by itself
  DB_NAME: tennis
  DB_USER: postgres
  DB_PASSWORD: change_me
