# this is a template for k8s/secret.yaml, the kubernetes version of .env.example
# copy it to secret.yaml and put your own password in it
# .gitignore keeps secret.yaml off github, so the real password never goes there
# the name ends in .example on purpose: kubectl apply -f k8s/ only reads .yaml files,
# so it skips this one and never overwrites the real secret with change_me

apiVersion: v1
kind: Secret
metadata:
  name: atp-db          # the api, the fetcher and the database find the secret by this name
type: Opaque            # a plain secret with my own keys in it, nothing special
stringData:             # I write the values as plain text here, and kubernetes stores them encoded by itself
  DB_NAME: tennis
  DB_USER: postgres
  DB_PASSWORD: change_me
