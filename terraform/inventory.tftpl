# terraform makes this file from terraform/inventory.tftpl and fills in the ip of the new server
# the Deploy workflow on github fills it in too, with sed instead of terraform
# don't change it by hand, terraform writes it again on every apply

# [atp] is the name of the group, the playbook uses it to know which servers to run on
[atp]
${ip}

# settings ansible uses for every server in the atp group
# comments have to go on their own line here, otherwise ansible reads them as part of the value
[atp:vars]
# the default user on aws ubuntu servers
ansible_user=ubuntu
# the private ssh key ansible logs in with, the copy I made in wsl
ansible_ssh_private_key_file=~/.ssh/atp-tracker
# ssh trusts a new server automatically the first time, instead of stopping to ask yes or no
ansible_ssh_common_args=-o StrictHostKeyChecking=accept-new
# where python is on the server, set here so ansible doesn't have to guess and warn about it
ansible_python_interpreter=/usr/bin/python3
